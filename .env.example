# Postgres connection string (Neon: pooled connection string from your Neon dashboard)
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"

# Admin CRM login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Random long secret used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET="change-me-to-a-random-64-char-hex-string"
